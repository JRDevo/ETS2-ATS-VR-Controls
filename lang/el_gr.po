#: src/vr_menu.cpp
msgid "Keyboard distance"
msgstr "Απόσταση πληκτρολογίου"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(hidden)"
msgstr "(κρυφό)"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the VR keyboard is from your head."
msgstr "Πόσο μακριά είναι το πληκτρολόγιο VR από το κεφάλι σου."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Show"
msgstr "Εμφάνιση"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Hide"
msgstr "Απόκρυψη"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Full"
msgstr "Πλήρες"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Compact"
msgstr "Συμπαγές"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Show / hide the VR keyboard. Full = every key; Compact = only the main keys (narrower)."
msgstr ""
"Εμφάνιση / απόκρυψη πληκτρολογίου VR. Πλήρες = όλα τα πλήκτρα· Συμπαγές = μόνο τα βασικά "
"(στενότερο)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Bring the menu and the keyboard in front of me"
msgstr "Φέρε το μενού και το πληκτρολόγιο μπροστά μου"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Moves the menu and the keyboard to where you look now."
msgstr "Μετακινεί το μενού και το πληκτρολόγιο εκεί που κοιτάς τώρα."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Menu open / close: hold %s for %.1f s"
msgstr "Άνοιγμα / κλείσιμο μενού: κράτα %s για %.1f δευτ."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Move: point at a panel, hold the grip, move. Its stick: farther / closer."
msgstr "Μετακίνηση: δείξε πάνελ, κράτα τη λαβή, κούνα. Μοχλός: μακριά / κοντά."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "The keyboard stays when the menu closes (its x hides it)."
msgstr "Το πληκτρολόγιο μένει όταν κλείνει το μενού (το «x» του το κρύβει)."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Dark"
msgstr "Σκούρο"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Blue"
msgstr "Μπλε"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Grey"
msgstr "Γκρι"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Light"
msgstr "Φωτεινό"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Black"
msgstr "Μαύρο"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Green"
msgstr "Πράσινο"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Colours"
msgstr "Χρώματα"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The colours of the menu and the keyboard."
msgstr "Τα χρώματα του μενού και του πληκτρολογίου."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu see-through"
msgstr "Διαφάνεια μενού"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%d %% solid"
msgstr "%d %% αδιαφ."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid this menu is. - = more see-through, + = more solid."
msgstr "Πόσο αδιαφανές είναι το μενού. - = πιο διαφανές, + = πιο αδιαφανές."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard see-through"
msgstr "Διαφάνεια πληκτρολογίου"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid the VR keyboard is. - = more see-through, + = more solid."
msgstr "Πόσο αδιαφανές είναι το πληκτρολόγιο VR. - = πιο διαφανές, + = πιο αδιαφανές."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Pointer smoothing"
msgstr "Εξομάλυνση δείκτη"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Low"
msgstr "Χαμηλή"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Medium"
msgstr "Μέτρια"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "High"
msgstr "Υψηλή"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Calms a shaky hand: the menu pointer and the air mouse. Higher = steadier, but it follows a bit "
"later."
msgstr "Ηρεμεί το τρέμουλο: τον δείκτη και το ποντίκι αέρα. Πιο ψηλά = πιο σταθερό, μα αργεί λίγο."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s (no font)"
msgstr "%s (χωρίς γραμμ.)"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Language"
msgstr "Γλώσσα"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Auto: %s"
msgstr "Αυτ.: %s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The menu's language. Auto = the language the game is set to."
msgstr "Η γλώσσα του μενού. Αυτ. = η γλώσσα του παιχνιδιού."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard letters"
msgstr "Γράμματα πληκτρολογίου"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The letters on the VR keyboard, as printed in that country. Auto = as the menu. A key always "
"presses the same key in the game."
msgstr ""
"Τα γράμματα του πληκτρολογίου VR, όπως τυπώνονται στη χώρα. Αυτ. = όπως το μενού. Το πλήκτρο πατά "
"πάντα το ίδιο πλήκτρο."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "- = more see-through, + = more solid."
msgstr "- = πιο διαφανές, + = πιο αδιαφανές."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steer with"
msgstr "Οδήγηση με"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick"
msgstr "Μοχλός"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Wheel"
msgstr "Τιμόνι"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Point"
msgstr "Δείξιμο"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick: the stick steers. Wheel: hold the grip(s) and turn your hands like a steering wheel. "
"Point: point a controller left / right (on a panel the wheel holds). Off: no driving."
msgstr ""
"Μοχλός: οδηγεί ο μοχλός. Τιμόνι: κράτα τη(ις) λαβή(ές) και γύρνα τα χέρια σαν τιμόνι. Δείξιμο: "
"δείξε αριστερά / δεξιά (σε πάνελ-τιμόνι). Ανενεργό: χωρίς οδήγηση."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hands turn for full lock"
msgstr "Στροφή χεριών για τέρμα"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Point for full lock"
msgstr "Δείξιμο για τέρμα"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.0f deg"
msgstr "%.0f°"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you turn your hands (like a wheel) for full lock. Less = quicker, more = calmer."
msgstr "Πόσο γυρνάς τα χέρια (σαν τιμόνι) για τέρμα. Λιγότερο = πιο γρήγορα, πιο πολύ = πιο ήρεμα."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you point left / right for full lock. Less = quicker, more = calmer."
msgstr "Πόσο δείχνεις αριστερά / δεξιά για τέρμα. Λιγότερο = πιο γρήγορα, πιο πολύ = πιο ήρεμα."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick on"
msgstr "Με μοχλό"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick off"
msgstr "Χωρίς μοχλό"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick on: the stick steers too (it wins while you push it). Stick off: only your hands steer, and "
"the stick's left / right are normal buttons again."
msgstr ""
"Με μοχλό: οδηγεί κι ο μοχλός (όσο τον σπρώχνεις, υπερισχύει). Χωρίς μοχλό: οδηγούν μόνο τα χέρια, "
"κι αρ. / δε. του μοχλού ξαναγίνονται κουμπιά."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hold the wheel with"
msgstr "Κράτα το τιμόνι με"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Either"
msgstr "Οποιαδήποτε"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Both: both grips together (one grip alone keeps its own job). Left / Right / Either: one grip is "
"enough -- that grip is then only the wheel (no modifier, no air mouse, no key on it)."
msgstr ""
"Και τα δύο: και οι δύο λαβές μαζί (μία λαβή κρατά τον ρόλο της). Αρ. / Δε. / Οποιαδήποτε: αρκεί "
"μία — τότε είναι μόνο τιμόνι (χωρίς τροποποιητή, ποντίκι αέρα, πλήκτρο)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hand that points"
msgstr "Χέρι που δείχνει"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The controller you point with. The other hand stays free for the keyboard and the menu."
msgstr "Το χειριστήριο που δείχνεις. Το άλλο χέρι μένει ελεύθερο για πληκτρολόγιο και μενού."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Stick that steers"
msgstr "Μοχλός που οδηγεί"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Which stick steers the truck (left / right). Its up / down stay free for other buttons."
msgstr "Ποιος μοχλός οδηγεί το φορτηγό (αρ. / δε.). Πάνω / κάτω μένουν για άλλα κουμπιά."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steering dead zone"
msgstr "Νεκρή ζώνη τιμονιού"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"How far you must push the stick before the wheel turns. More = a calm middle, less = it reacts "
"sooner."
msgstr ""
"Πόσο να σπρώξεις τον μοχλό πριν στρίψει το τιμόνι. Πιο πολύ = ήρεμο κέντρο, λιγότερο = αντιδρά "
"νωρίτερα."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Small turns (most of the stick)"
msgstr "Μικρές στροφές (μεγ. μέρος μοχλού)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "even (off)"
msgstr "γραμμικό (όχι)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "up to %d %%"
msgstr "έως %d %%"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid ""
"Most of the stick (the first %d %% of a push) makes small, careful turns, up to this much of the "
"wheel. Only the last bit, at the edge, turns hard."
msgstr ""
"Το μεγαλύτερο μέρος του μοχλού (το πρώτο %d %% της ώθησης) κάνει μικρές, προσεκτικές στροφές, ως "
"αυτό το μέρος του τιμονιού. Μόνο η άκρη στρίβει απότομα."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Full stick turns the wheel"
msgstr "Μοχλός τέρμα: στροφή τιμονιού"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the wheel turns with the stick pushed all the way. 100 % = full lock."
msgstr "Πόσο γυρνά το τιμόνι με τον μοχλό τέρμα. 100 % = τέρμα."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel follows the stick"
msgstr "Το τιμόνι ακολουθεί τον μοχλό"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "at once"
msgstr "αμέσως"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.3g s"
msgstr "%.3g δευτ."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Smoothing while you hold the stick: how quickly the wheel goes where the stick points. More = "
"smoother, calmer."
msgstr ""
"Εξομάλυνση όσο κρατάς τον μοχλό: πόσο γρήγορα το τιμόνι πάει εκεί που δείχνει. Πιο πολύ = πιο "
"ομαλό, ήρεμο."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Let go: back to the middle"
msgstr "Αφήνεις — στο κέντρο"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Let go of the stick: how the wheel comes back to straight. At once = at the wheel speed below. "
"More = a slow glide."
msgstr ""
"Αφήνεις τον μοχλό: πώς το τιμόνι γυρνά ίσια. Αμέσως = με την ταχύτητα τιμονιού κάτω. Πιο πολύ = "
"αργό γλίστρημα."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel speed at most"
msgstr "Μέγ. ταχύτητα τιμονιού"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "no limit"
msgstr "χωρίς όριο"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2g s to full"
msgstr "%.2g δ ως τέρμα"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The fastest the wheel turns (full push; a small push turns it slower): seconds from straight to "
"full lock."
msgstr ""
"Η πιο γρήγορη στροφή τιμονιού (τέρμα ώθηση· μικρή — πιο αργά): δευτερόλεπτα από ίσια ως τέρμα."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "At 90 km/h: steering"
msgstr "Στα 90 km/h: τιμόνι"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "On"
msgstr "Ενεργό"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(off)"
msgstr "(ανενεργό)"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "On: at speed the wheel turns less, for calm highway driving. The % = how much at 90 km/h."
msgstr ""
"Ενεργό: στην ταχύτητα το τιμόνι στρίβει λιγότερο, για ήρεμη οδήγηση σε αυτοκινητόδρομο. % = πόσο "
"στα 90 km/h."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Driving off: no steering, gas or brake."
msgstr "Οδήγηση ανενεργή: χωρίς τιμόνι, γκάζι, φρένο."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel: hold the grip(s) and turn your hands. Let go = straight."
msgstr "Τιμόνι: κράτα τη(ις) λαβή(ές) και γύρνα τα χέρια. Αφήνεις = ίσια."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Point: point left / right. On a panel the wheel holds."
msgstr "Δείξιμο: δείξε αριστερά / δεξιά. Σε πάνελ-τιμόνι."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Most of the stick = small turns. All the way = hard turns."
msgstr "Μεγ. μέρος μοχλού = μικρές στροφές. Τέρμα = απότομες."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Sure? Reset"
msgstr "Σίγουρα; Επαν."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Reset tab"
msgstr "Επαναφορά"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Puts this tab back to the default settings. Press twice to be sure."
msgstr "Επαναφέρει αυτή την καρτέλα στις προεπιλογές. Πάτα δύο φορές για επιβεβαίωση."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s + %s = %s"
msgstr "Ορ.: %s + %s = %s"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s = %s"
msgstr "Ορ.: %s = %s"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Press again: this tab goes back to the defaults."
msgstr "Πάτα ξανά: η καρτέλα γυρνά στις προεπιλογές."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Back to the defaults. Saved."
msgstr "Επαναφορά προεπιλογών. Αποθηκεύτηκε."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Saved."
msgstr "Αποθηκεύτηκε."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Choose that modifier button first (the buttons above)."
msgstr "Πρώτα διάλεξε αυτό το κουμπί-τροποποιητή (πάνω)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Steering with the wheel: those grips hold it (Driving tab)."
msgstr "Τιμόνι: αυτές οι λαβές το κρατούν (καρτέλα «Οδήγηση»)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s holds the wheel (Driving tab)."
msgstr "%s κρατά το τιμόνι (καρτέλα «Οδήγηση»)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 1."
msgstr "%s είναι τροποποιητής 1."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 2."
msgstr "%s είναι τροποποιητής 2."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is the air mouse button (Mouse tab)."
msgstr "%s είναι το κουμπί ποντικιού αέρα (καρτέλα «Ποντίκι»)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "With these modifiers, %s opens the menu."
msgstr "Με αυτούς τους τροποποιητές, %s ανοίγει το μενού."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick moves the mouse (Mouse tab)."
msgstr "Αυτός ο μοχλός κινεί το ποντίκι (καρτέλα «Ποντίκι»)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick steers (Driving tab)."
msgstr "Αυτός ο μοχλός οδηγεί (καρτέλα «Οδήγηση»)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Could not save config.ini (the change works until the game ends)."
msgstr "Αδυναμία αποθήκευσης config.ini (η αλλαγή ισχύει ως το τέλος του παιχνιδιού)."

