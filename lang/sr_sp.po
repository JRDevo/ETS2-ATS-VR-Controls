msgstr "Tamna"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Blue"
msgstr "Plava"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Grey"
msgstr "Siva"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Light"
msgstr "Svetla"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Black"
msgstr "Crna"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Green"
msgstr "Zelena"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Colours"
msgstr "Boje"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The colours of the menu and the keyboard."
msgstr "Boje menija i tastature."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu see-through"
msgstr "Providnost menija"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%d %% solid"
msgstr "%d %% neprov."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid this menu is. - = more see-through, + = more solid."
msgstr "Koliko je meni neprovidan. - = providnije, + = neprovidnije."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard see-through"
msgstr "Providnost tastature"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid the VR keyboard is. - = more see-through, + = more solid."
msgstr "Koliko je VR tastatura neprovidna. - = providnije, + = neprovidnije."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Pointer smoothing"
msgstr "Ujednačavanje pokazivača"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Low"
msgstr "Nisko"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Medium"
msgstr "Srednje"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "High"
msgstr "Visoko"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Calms a shaky hand: the menu pointer and the air mouse. Higher = steadier, but it follows a bit "
"later."
msgstr ""
"Smiruje drhtanje ruke: pokazivač menija i vazdušni miš. Više = stabilnije, ali reaguje malo "
"kasnije."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s (no font)"
msgstr "%s (nema font)"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Language"
msgstr "Jezik"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Auto: %s"
msgstr "Auto: %s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The menu's language. Auto = the language the game is set to."
msgstr "Jezik menija. Auto = jezik podešen u igri."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard letters"
msgstr "Slova na tastaturi"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The letters on the VR keyboard, as printed in that country. Auto = as the menu. A key always "
"presses the same key in the game."
msgstr ""
"Slova na VR tastaturi, kao što se štampaju u toj zemlji. Auto = kao meni. Taster uvek pritisne "
"isti taster u igri."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "- = more see-through, + = more solid."
msgstr "- = providnije, + = neprovidnije."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steer with"
msgstr "Upravljaj sa"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick"
msgstr "Stik"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Wheel"
msgstr "Volan"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Point"
msgstr "Pokazivanje"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick: the stick steers. Wheel: hold the grip(s) and turn your hands like a steering wheel. "
"Point: point a controller left / right (on a panel the wheel holds). Off: no driving."
msgstr ""
"Stik: upravlja stik. Volan: drži grip(ove) i okreći ruke kao volan. Pokazivanje: usmeri kontroler "
"levo / desno (na panelu koji drži volan). Isključeno: bez vožnje."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hands turn for full lock"
msgstr "Okret ruku do kraja"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Point for full lock"
msgstr "Pokazivanje do kraja"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.0f deg"
msgstr "%.0f°"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you turn your hands (like a wheel) for full lock. Less = quicker, more = calmer."
msgstr "Koliko da okreneš ruke (kao volan) do kraja. Manje = brže, više = mirnije."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you point left / right for full lock. Less = quicker, more = calmer."
msgstr "Koliko da pokazuješ levo / desno do kraja. Manje = brže, više = mirnije."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick on"
msgstr "Stik uklj."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick off"
msgstr "Stik isklj."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick on: the stick steers too (it wins while you push it). Stick off: only your hands steer, and "
"the stick's left / right are normal buttons again."
msgstr ""
"Stik uklj.: i stik upravlja (dok ga guraš, on vodi). Stik isklj.: upravljaju samo ruke, a levo / "
"desno stika su opet obična dugmad."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hold the wheel with"
msgstr "Drži volan sa"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Either"
msgstr "Bilo koji"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Both: both grips together (one grip alone keeps its own job). Left / Right / Either: one grip is "
"enough -- that grip is then only the wheel (no modifier, no air mouse, no key on it)."
msgstr ""
"Oba: oba gripa zajedno (jedan grip zadrži svoju ulogu). Levi / Desni / Bilo koji: dovoljan je "
"jedan — tada je samo volan (bez modifikatora, vazdušnog miša, tastera)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hand that points"
msgstr "Ruka koja pokazuje"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The controller you point with. The other hand stays free for the keyboard and the menu."
msgstr "Kontroler kojim pokazuješ. Druga ruka ostaje slobodna za tastaturu i meni."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Stick that steers"
msgstr "Stik koji upravlja"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Which stick steers the truck (left / right). Its up / down stay free for other buttons."
msgstr "Koji stik upravlja kamionom (levo / desno). Gore / dole ostaju za druga dugmad."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steering dead zone"
msgstr "Mrtva zona upravljanja"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"How far you must push the stick before the wheel turns. More = a calm middle, less = it reacts "
"sooner."
msgstr ""
"Koliko gurnuti stik pre nego što volan skrene. Više = mirna sredina, manje = reaguje ranije."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Small turns (most of the stick)"
msgstr "Mali zaokreti (veći deo stika)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "even (off)"
msgstr "jednako (isklj.)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "up to %d %%"
msgstr "do %d %%"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid ""
"Most of the stick (the first %d %% of a push) makes small, careful turns, up to this much of the "
"wheel. Only the last bit, at the edge, turns hard."
msgstr ""
"Veći deo stika (prvih %d %% hoda) pravi male, pažljive zaokrete, do ovog dela volana. Samo kraj, "
"na ivici, okreće naglo."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Full stick turns the wheel"
msgstr "Pun stik okreće volan"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the wheel turns with the stick pushed all the way. 100 % = full lock."
msgstr "Koliko volan skrene pri potpuno gurnutom stiku. 100 % = do kraja."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel follows the stick"
msgstr "Volan prati stik"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "at once"
msgstr "odmah"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.3g s"
msgstr "%.3g s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Smoothing while you hold the stick: how quickly the wheel goes where the stick points. More = "
"smoother, calmer."
msgstr ""
"Ujednačavanje dok držiš stik: koliko brzo volan ide kuda stik pokazuje. Više = glatkije, mirnije."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Let go: back to the middle"
msgstr "Pustiš — ka sredini"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Let go of the stick: how the wheel comes back to straight. At once = at the wheel speed below. "
"More = a slow glide."
msgstr ""
"Pustiš stik: kako se volan vraća na pravo. Odmah = brzinom volana dole. Više = sporo klizanje."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel speed at most"
msgstr "Najveća brzina volana"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "no limit"
msgstr "bez granice"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2g s to full"
msgstr "%.2g s do kraja"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The fastest the wheel turns (full push; a small push turns it slower): seconds from straight to "
"full lock."
msgstr "Najbrže okretanje volana (pun potisak; mali — sporije): sekunde od pravog do kraja."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "At 90 km/h: steering"
msgstr "Na 90 km/h: upravljanje"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "On"
msgstr "Uključeno"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(off)"
msgstr "(isključeno)"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "On: at speed the wheel turns less, for calm highway driving. The % = how much at 90 km/h."
msgstr "Uklj.: pri brzini volan skreće manje, za miran autoput. % = koliko na 90 km/h."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Driving off: no steering, gas or brake."
msgstr "Vožnja isklj.: bez upravljanja, gasa i kočnice."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel: hold the grip(s) and turn your hands. Let go = straight."
msgstr "Volan: drži grip(ove) i okreći ruke. Pustiš = pravo."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Point: point left / right. On a panel the wheel holds."
msgstr "Pokazivanje: usmeri levo / desno. Na panelu koji drži volan."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Most of the stick = small turns. All the way = hard turns."
msgstr "Veći deo stika = mali zaokreti. Do kraja = nagli."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Sure? Reset"
msgstr "Sigurno? Vrati"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Reset tab"
msgstr "Resetuj"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Puts this tab back to the default settings. Press twice to be sure."
msgstr "Vraća ovu karticu na podrazumevane postavke. Pritisni dvaput za potvrdu."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s + %s = %s"
msgstr "Podešeno: %s + %s = %s"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s = %s"
msgstr "Podešeno: %s = %s"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Press again: this tab goes back to the defaults."
msgstr "Pritisni ponovo: ova kartica se vraća na podrazumevano."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Back to the defaults. Saved."
msgstr "Vraćeno na podrazumevano. Sačuvano."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Saved."
msgstr "Sačuvano."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Choose that modifier button first (the buttons above)."
msgstr "Prvo izaberi to dugme-modifikator (dugmad gore)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Steering with the wheel: those grips hold it (Driving tab)."
msgstr "Volan: ti gripovi ga drže (kartica „Vožnja“)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s holds the wheel (Driving tab)."
msgstr "%s drži volan (kartica „Vožnja“)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 1."
msgstr "%s je modifikator 1."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 2."
msgstr "%s je modifikator 2."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is the air mouse button (Mouse tab)."
msgstr "%s je dugme vazdušnog miša (kartica „Miš“)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "With these modifiers, %s opens the menu."
msgstr "Sa ovim modifikatorima %s otvara meni."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick moves the mouse (Mouse tab)."
msgstr "Taj stik pomera miša (kartica „Miš“)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick steers (Driving tab)."
msgstr "Taj stik upravlja (kartica „Vožnja“)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Could not save config.ini (the change works until the game ends)."
msgstr "Nije moguće sačuvati config.ini (promena važi do kraja igre)."

