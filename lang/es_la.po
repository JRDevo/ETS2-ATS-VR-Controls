#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Light"
msgstr "Claro"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Black"
msgstr "Negro"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Green"
msgstr "Verde"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Colours"
msgstr "Colores"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The colours of the menu and the keyboard."
msgstr "Los colores del menú y del teclado."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu see-through"
msgstr "Transparencia del menú"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%d %% solid"
msgstr "%d %% opaco"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid this menu is. - = more see-through, + = more solid."
msgstr "Cuán opaco es este menú. - = más transparente, + = más opaco."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard see-through"
msgstr "Transparencia del teclado"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid the VR keyboard is. - = more see-through, + = more solid."
msgstr "Cuán opaco es el teclado VR. - = más transparente, + = más opaco."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Pointer smoothing"
msgstr "Suavizado del puntero"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Low"
msgstr "Bajo"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Medium"
msgstr "Medio"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "High"
msgstr "Alto"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Calms a shaky hand: the menu pointer and the air mouse. Higher = steadier, but it follows a bit "
"later."
msgstr ""
"Calma el pulso tembloroso: el puntero del menú y el air mouse. Más alto = más estable, pero sigue "
"un poco después."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s (no font)"
msgstr "%s (sin fuente)"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Language"
msgstr "Idioma"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Auto: %s"
msgstr "Auto: %s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The menu's language. Auto = the language the game is set to."
msgstr "El idioma del menú. Auto = el idioma configurado en el juego."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard letters"
msgstr "Letras del teclado"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The letters on the VR keyboard, as printed in that country. Auto = as the menu. A key always "
"presses the same key in the game."
msgstr ""
"Las letras del teclado VR, como en ese país. Auto = como el menú. Una tecla siempre pulsa la "
"misma tecla en el juego."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "- = more see-through, + = more solid."
msgstr "- = más transparente, + = más opaco."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steer with"
msgstr "Dirigir con"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick"
msgstr "Stick"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Wheel"
msgstr "Volante"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Point"
msgstr "Apuntar"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick: the stick steers. Wheel: hold the grip(s) and turn your hands like a steering wheel. "
"Point: point a controller left / right (on a panel the wheel holds). Off: no driving."
msgstr ""
"Stick: el stick dirige. Volante: mantén el/los grip(s) y gira las manos como un volante. Apuntar: "
"apunta un control a izquierda / derecha (en un panel que el volante sujeta). Desactivado: sin "
"conducción."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hands turn for full lock"
msgstr "Giro de manos al máximo"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Point for full lock"
msgstr "Apuntar al máximo"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.0f deg"
msgstr "%.0f°"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you turn your hands (like a wheel) for full lock. Less = quicker, more = calmer."
msgstr ""
"Cuánto giras las manos (como un volante) para el giro máximo. Menos = más rápido, más = más suave."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you point left / right for full lock. Less = quicker, more = calmer."
msgstr ""
"Cuánto apuntas a izquierda / derecha para el giro máximo. Menos = más rápido, más = más suave."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick on"
msgstr "Con stick"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick off"
msgstr "Sin stick"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick on: the stick steers too (it wins while you push it). Stick off: only your hands steer, and "
"the stick's left / right are normal buttons again."
msgstr ""
"Con stick: el stick también dirige (gana mientras lo empujas). Sin stick: solo tus manos dirigen, "
"e izquierda / derecha del stick vuelven a ser botones normales."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hold the wheel with"
msgstr "Sujetar el volante con"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Either"
msgstr "Cualquiera"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Both: both grips together (one grip alone keeps its own job). Left / Right / Either: one grip is "
"enough -- that grip is then only the wheel (no modifier, no air mouse, no key on it)."
msgstr ""
"Ambos: los dos grips juntos (un solo grip mantiene su función). Izquierdo / Derecho / Cualquiera: "
"basta un grip -- ese grip es entonces solo el volante (sin modificador, sin air mouse, sin tecla)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hand that points"
msgstr "Mano que apunta"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The controller you point with. The other hand stays free for the keyboard and the menu."
msgstr "El control con el que apuntas. La otra mano queda libre para el teclado y el menú."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Stick that steers"
msgstr "Stick que dirige"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Which stick steers the truck (left / right). Its up / down stay free for other buttons."
msgstr ""
"Qué stick dirige el camión (izquierda / derecha). Su arriba / abajo queda libre para otros "
"botones."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steering dead zone"
msgstr "Zona muerta de dirección"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"How far you must push the stick before the wheel turns. More = a calm middle, less = it reacts "
"sooner."
msgstr ""
"Cuánto empujar el stick antes de que el volante gire. Más = un centro tranquilo, menos = "
"reacciona antes."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Small turns (most of the stick)"
msgstr "Giros suaves (casi todo)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "even (off)"
msgstr "lineal (desact.)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "up to %d %%"
msgstr "hasta %d %%"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid ""
"Most of the stick (the first %d %% of a push) makes small, careful turns, up to this much of the "
"wheel. Only the last bit, at the edge, turns hard."
msgstr ""
"La mayor parte del stick (el primer %d %% de un empuje) hace giros suaves y precisos, hasta esta "
"parte del volante. Solo el final, en el borde, gira fuerte."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Full stick turns the wheel"
msgstr "Stick al máximo gira el volante"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the wheel turns with the stick pushed all the way. 100 % = full lock."
msgstr "Cuánto gira el volante con el stick al máximo. 100 % = giro máximo."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel follows the stick"
msgstr "El volante sigue al stick"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "at once"
msgstr "al instante"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.3g s"
msgstr "%.3g s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Smoothing while you hold the stick: how quickly the wheel goes where the stick points. More = "
"smoother, calmer."
msgstr ""
"Suavizado mientras mantienes el stick: con qué rapidez el volante va adonde apunta el stick. Más "
"= más suave y tranquilo."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Let go: back to the middle"
msgstr "Al soltar: vuelve al centro"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Let go of the stick: how the wheel comes back to straight. At once = at the wheel speed below. "
"More = a slow glide."
msgstr ""
"Suelta el stick: cómo el volante vuelve recto. Al instante = a la velocidad del volante de abajo. "
"Más = un regreso lento."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel speed at most"
msgstr "Velocidad máx. del volante"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "no limit"
msgstr "sin límite"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2g s to full"
msgstr "%.2g s al máx."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The fastest the wheel turns (full push; a small push turns it slower): seconds from straight to "
"full lock."
msgstr ""
"La máxima velocidad del volante (empuje a tope; un empuje pequeño lo gira más lento): segundos de "
"recto a giro máximo."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "At 90 km/h: steering"
msgstr "A 90 km/h: dirección"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "On"
msgstr "Activado"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(off)"
msgstr "(desactivado)"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "On: at speed the wheel turns less, for calm highway driving. The % = how much at 90 km/h."
msgstr ""
"Activado: a velocidad el volante gira menos, para autopista tranquila. El % = cuánto a 90 km/h."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Driving off: no steering, gas or brake."
msgstr "Conducción desactivada: sin dirección, gas ni freno."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel: hold the grip(s) and turn your hands. Let go = straight."
msgstr "Volante: mantén el/los grip(s) y gira las manos. Suelta = recto."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Point: point left / right. On a panel the wheel holds."
msgstr "Apuntar: apunta a izquierda / derecha. En un panel que el volante sujeta."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Most of the stick = small turns. All the way = hard turns."
msgstr "Casi todo el stick = giros suaves. Al máximo = giros fuertes."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Sure? Reset"
msgstr "¿Seguro?"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Reset tab"
msgstr "Restablecer"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Puts this tab back to the default settings. Press twice to be sure."
msgstr "Devuelve esta pestaña a los ajustes por defecto. Presiona dos veces para confirmar."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s + %s = %s"
msgstr "Asignado: %s + %s = %s"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s = %s"
msgstr "Asignado: %s = %s"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Press again: this tab goes back to the defaults."
msgstr "Presiona otra vez: esta pestaña vuelve a los valores por defecto."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Back to the defaults. Saved."
msgstr "Vuelta a los valores por defecto. Guardado."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Saved."
msgstr "Guardado."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Choose that modifier button first (the buttons above)."
msgstr "Elige primero ese botón modificador (los botones de arriba)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Steering with the wheel: those grips hold it (Driving tab)."
msgstr "Dirección con volante: esos grips lo sujetan (pestaña Conducción)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s holds the wheel (Driving tab)."
msgstr "%s sujeta el volante (pestaña Conducción)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 1."
msgstr "%s es el modificador 1."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 2."
msgstr "%s es el modificador 2."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is the air mouse button (Mouse tab)."
msgstr "%s es el botón del air mouse (pestaña Mouse)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "With these modifiers, %s opens the menu."
msgstr "Con estos modificadores, %s abre el menú."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick moves the mouse (Mouse tab)."
msgstr "Ese stick mueve el mouse (pestaña Mouse)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick steers (Driving tab)."
msgstr "Ese stick dirige (pestaña Conducción)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Could not save config.ini (the change works until the game ends)."
msgstr "No se pudo guardar config.ini (el cambio vale hasta que cierres el juego)."

