msgstr "Gris"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Light"
msgstr "Clair"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Black"
msgstr "Noir"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Green"
msgstr "Vert"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Colours"
msgstr "Couleurs"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The colours of the menu and the keyboard."
msgstr "Les couleurs du menu et du clavier."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu see-through"
msgstr "Transparence du menu"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%d %% solid"
msgstr "%d %% opaque"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid this menu is. - = more see-through, + = more solid."
msgstr "À quel point ce menu est opaque. - = plus transparent, + = plus opaque."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard see-through"
msgstr "Transparence du clavier"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid the VR keyboard is. - = more see-through, + = more solid."
msgstr "À quel point le clavier VR est opaque. - = plus transparent, + = plus opaque."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Pointer smoothing"
msgstr "Lissage du pointeur"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Low"
msgstr "Faible"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Medium"
msgstr "Moyen"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "High"
msgstr "Élevé"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Calms a shaky hand: the menu pointer and the air mouse. Higher = steadier, but it follows a bit "
"later."
msgstr ""
"Calme une main qui tremble : le pointeur du menu et l'air mouse. Plus haut = plus stable, mais "
"suit un peu après."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s (no font)"
msgstr "%s (pas de police)"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Language"
msgstr "Langue"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Auto: %s"
msgstr "Auto : %s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The menu's language. Auto = the language the game is set to."
msgstr "La langue du menu. Auto = la langue réglée dans le jeu."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard letters"
msgstr "Lettres du clavier"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The letters on the VR keyboard, as printed in that country. Auto = as the menu. A key always "
"presses the same key in the game."
msgstr ""
"Les lettres du clavier VR, comme dans ce pays. Auto = comme le menu. Une touche presse toujours "
"la même touche dans le jeu."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "- = more see-through, + = more solid."
msgstr "- = plus transparent, + = plus opaque."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steer with"
msgstr "Diriger avec"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick"
msgstr "Stick"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Wheel"
msgstr "Volant"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Point"
msgstr "Pointer"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick: the stick steers. Wheel: hold the grip(s) and turn your hands like a steering wheel. "
"Point: point a controller left / right (on a panel the wheel holds). Off: no driving."
msgstr ""
"Stick : le stick dirige. Volant : tiens le(s) grip(s) et tourne les mains comme un volant. "
"Pointer : pointe une manette à gauche / droite (sur un panneau que le volant tient). Désactivé : "
"pas de conduite."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hands turn for full lock"
msgstr "Rotation des mains à fond"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Point for full lock"
msgstr "Pointage à fond"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.0f deg"
msgstr "%.0f°"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you turn your hands (like a wheel) for full lock. Less = quicker, more = calmer."
msgstr ""
"De combien tu tournes les mains (comme un volant) pour le braquage max. Moins = plus vif, plus = "
"plus doux."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you point left / right for full lock. Less = quicker, more = calmer."
msgstr ""
"De combien tu pointes à gauche / droite pour le braquage max. Moins = plus vif, plus = plus doux."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick on"
msgstr "Avec stick"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick off"
msgstr "Sans stick"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick on: the stick steers too (it wins while you push it). Stick off: only your hands steer, and "
"the stick's left / right are normal buttons again."
msgstr ""
"Avec stick : le stick dirige aussi (il gagne tant que tu le pousses). Sans stick : seules tes "
"mains dirigent, et gauche / droite du stick redeviennent des boutons normaux."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hold the wheel with"
msgstr "Tenir le volant avec"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Either"
msgstr "L'un ou l'autre"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Both: both grips together (one grip alone keeps its own job). Left / Right / Either: one grip is "
"enough -- that grip is then only the wheel (no modifier, no air mouse, no key on it)."
msgstr ""
"Les deux : les deux grips ensemble (un seul grip garde son propre rôle). Gauche / Droite / L'un "
"ou l'autre : un seul grip suffit -- ce grip n'est alors que le volant (pas de modificateur, pas "
"d'air mouse, pas de touche dessus)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hand that points"
msgstr "Main qui pointe"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The controller you point with. The other hand stays free for the keyboard and the menu."
msgstr "La manette avec laquelle tu pointes. L'autre main reste libre pour le clavier et le menu."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Stick that steers"
msgstr "Stick qui dirige"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Which stick steers the truck (left / right). Its up / down stay free for other buttons."
msgstr ""
"Quel stick dirige le camion (gauche / droite). Son haut / bas reste libre pour d'autres boutons."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steering dead zone"
msgstr "Zone morte de direction"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"How far you must push the stick before the wheel turns. More = a calm middle, less = it reacts "
"sooner."
msgstr ""
"Jusqu'où pousser le stick avant que le volant tourne. Plus = un centre calme, moins = il réagit "
"plus tôt."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Small turns (most of the stick)"
msgstr "Petits virages (gros du stick)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "even (off)"
msgstr "linéaire (off)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "up to %d %%"
msgstr "jusqu'à %d %%"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid ""
"Most of the stick (the first %d %% of a push) makes small, careful turns, up to this much of the "
"wheel. Only the last bit, at the edge, turns hard."
msgstr ""
"Le gros du stick (les premiers %d %% d'une poussée) fait des virages doux et précis, jusqu'à "
"cette part du volant. Seul le bout, au bord, braque fort."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Full stick turns the wheel"
msgstr "Stick à fond tourne le volant"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the wheel turns with the stick pushed all the way. 100 % = full lock."
msgstr "De combien le volant tourne avec le stick à fond. 100 % = braquage max."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel follows the stick"
msgstr "Le volant suit le stick"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "at once"
msgstr "aussitôt"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.3g s"
msgstr "%.3g s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Smoothing while you hold the stick: how quickly the wheel goes where the stick points. More = "
"smoother, calmer."
msgstr ""
"Lissage pendant que tu tiens le stick : à quelle vitesse le volant va là où pointe le stick. Plus "
"= plus doux, plus calme."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Let go: back to the middle"
msgstr "Relâché : retour au centre"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Let go of the stick: how the wheel comes back to straight. At once = at the wheel speed below. "
"More = a slow glide."
msgstr ""
"Relâche le stick : comment le volant revient tout droit. Aussitôt = à la vitesse du volant plus "
"bas. Plus = un lent retour."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel speed at most"
msgstr "Vitesse max du volant"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "no limit"
msgstr "sans limite"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2g s to full"
msgstr "%.2g s à fond"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The fastest the wheel turns (full push; a small push turns it slower): seconds from straight to "
"full lock."
msgstr ""
"La vitesse max du volant (poussée à fond ; une petite poussée le tourne plus lentement) : "
"secondes de tout droit au braquage max."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "At 90 km/h: steering"
msgstr "À 90 km/h : direction"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "On"
msgstr "Activé"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(off)"
msgstr "(désactivé)"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "On: at speed the wheel turns less, for calm highway driving. The % = how much at 90 km/h."
msgstr ""
"Activé : à vitesse élevée le volant tourne moins, pour une autoroute calme. Le % = combien à 90 "
"km/h."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Driving off: no steering, gas or brake."
msgstr "Conduite désactivée : ni direction, ni gaz, ni frein."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel: hold the grip(s) and turn your hands. Let go = straight."
msgstr "Volant : tiens le(s) grip(s) et tourne les mains. Relâche = tout droit."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Point: point left / right. On a panel the wheel holds."
msgstr "Pointer : pointe à gauche / droite. Sur un panneau que le volant tient."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Most of the stick = small turns. All the way = hard turns."
msgstr "Le gros du stick = petits virages. À fond = virages serrés."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Sure? Reset"
msgstr "Confirmer"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Reset tab"
msgstr "Réinit."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Puts this tab back to the default settings. Press twice to be sure."
msgstr "Remet cet onglet aux réglages par défaut. Appuie deux fois pour confirmer."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s + %s = %s"
msgstr "Réglé : %s + %s = %s"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s = %s"
msgstr "Réglé : %s = %s"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Press again: this tab goes back to the defaults."
msgstr "Appuie encore : cet onglet revient aux valeurs par défaut."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Back to the defaults. Saved."
msgstr "Retour aux valeurs par défaut. Enregistré."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Saved."
msgstr "Enregistré."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Choose that modifier button first (the buttons above)."
msgstr "Choisis d'abord ce bouton modificateur (les boutons au-dessus)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Steering with the wheel: those grips hold it (Driving tab)."
msgstr "Direction au volant : ces grips le tiennent (onglet Conduite)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s holds the wheel (Driving tab)."
msgstr "%s tient le volant (onglet Conduite)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 1."
msgstr "%s est le modificateur 1."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 2."
msgstr "%s est le modificateur 2."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is the air mouse button (Mouse tab)."
msgstr "%s est le bouton de l'air mouse (onglet Souris)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "With these modifiers, %s opens the menu."
msgstr "Avec ces modificateurs, %s ouvre le menu."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick moves the mouse (Mouse tab)."
msgstr "Ce stick déplace la souris (onglet Souris)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick steers (Driving tab)."
msgstr "Ce stick dirige (onglet Conduite)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Could not save config.ini (the change works until the game ends)."
msgstr "Impossible d'enregistrer config.ini (le changement tient jusqu'à la fin du jeu)."

