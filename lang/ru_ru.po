#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Show / hide the VR keyboard. Full = every key; Compact = only the main keys (narrower)."
msgstr "Показать / скрыть VR-клавиатуру. Полная = все клавиши; Компакт = только основные (уже)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Bring the menu and the keyboard in front of me"
msgstr "Поставить меню и клавиатуру передо мной"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Moves the menu and the keyboard to where you look now."
msgstr "Перемещает меню и клавиатуру туда, куда ты сейчас смотришь."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Menu open / close: hold %s for %.1f s"
msgstr "Открыть / закрыть меню: удерживай %s %.1f с"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Move: point at a panel, hold the grip, move. Its stick: farther / closer."
msgstr "Перемещение: наведи на панель, зажми грип, двигай. Её стик: дальше / ближе."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "The keyboard stays when the menu closes (its x hides it)."
msgstr "Клавиатура остаётся при закрытии меню (её «x» скрывает)."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Dark"
msgstr "Тёмная"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Blue"
msgstr "Синяя"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Grey"
msgstr "Серая"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Light"
msgstr "Светлая"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Black"
msgstr "Чёрная"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Green"
msgstr "Зелёная"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Colours"
msgstr "Цвета"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The colours of the menu and the keyboard."
msgstr "Цвета меню и клавиатуры."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu see-through"
msgstr "Прозрачность меню"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%d %% solid"
msgstr "%d %% непрозр."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid this menu is. - = more see-through, + = more solid."
msgstr "Насколько непрозрачно это меню. - = прозрачнее, + = плотнее."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard see-through"
msgstr "Прозрачность клавиатуры"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid the VR keyboard is. - = more see-through, + = more solid."
msgstr "Насколько непрозрачна VR-клавиатура. - = прозрачнее, + = плотнее."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Pointer smoothing"
msgstr "Сглаживание указателя"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Low"
msgstr "Низкое"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Medium"
msgstr "Среднее"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "High"
msgstr "Высокое"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Calms a shaky hand: the menu pointer and the air mouse. Higher = steadier, but it follows a bit "
"later."
msgstr ""
"Успокаивает дрожь руки: указатель меню и воздушную мышь. Больше = ровнее, но реакция чуть позже."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s (no font)"
msgstr "%s (нет шрифта)"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Language"
msgstr "Язык"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Auto: %s"
msgstr "Авто: %s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The menu's language. Auto = the language the game is set to."
msgstr "Язык меню. Авто = язык, выбранный в игре."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard letters"
msgstr "Буквы на клавиатуре"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The letters on the VR keyboard, as printed in that country. Auto = as the menu. A key always "
"presses the same key in the game."
msgstr ""
"Буквы на VR-клавиатуре, как напечатаны в стране. Авто = как меню. Клавиша всегда жмёт ту же "
"клавишу в игре."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "- = more see-through, + = more solid."
msgstr "- = прозрачнее, + = плотнее."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steer with"
msgstr "Чем рулить"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick"
msgstr "Стик"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Wheel"
msgstr "Руль"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Point"
msgstr "Наведение"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick: the stick steers. Wheel: hold the grip(s) and turn your hands like a steering wheel. "
"Point: point a controller left / right (on a panel the wheel holds). Off: no driving."
msgstr ""
"Стик: рулит стик. Руль: держи грип(ы) и крути руками, как руль. Наведение: наводи контроллер "
"влево / вправо (на панели руля). Выкл: без вождения."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hands turn for full lock"
msgstr "Поворот рук до упора"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Point for full lock"
msgstr "Наведение до упора"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.0f deg"
msgstr "%.0f°"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you turn your hands (like a wheel) for full lock. Less = quicker, more = calmer."
msgstr "Насколько повернуть руки (как руль) до упора. Меньше = быстрее, больше = спокойнее."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you point left / right for full lock. Less = quicker, more = calmer."
msgstr "Насколько наводить влево / вправо до упора. Меньше = быстрее, больше = спокойнее."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick on"
msgstr "Стик вкл"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick off"
msgstr "Стик выкл"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick on: the stick steers too (it wins while you push it). Stick off: only your hands steer, and "
"the stick's left / right are normal buttons again."
msgstr ""
"Стик вкл: стик тоже рулит (пока его толкаешь, он главнее). Стик выкл: рулят только руки, а лево / "
"право стика снова обычные кнопки."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hold the wheel with"
msgstr "Чем держать руль"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Either"
msgstr "Любой"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Both: both grips together (one grip alone keeps its own job). Left / Right / Either: one grip is "
"enough -- that grip is then only the wheel (no modifier, no air mouse, no key on it)."
msgstr ""
"Оба: оба грипа вместе (один грип сохраняет свою роль). Левый / Правый / Любой: хватает одного — "
"тогда этот грип только руль (без модификатора, воздушной мыши и клавиши)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hand that points"
msgstr "Рука для наведения"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The controller you point with. The other hand stays free for the keyboard and the menu."
msgstr "Контроллер, которым ты указываешь. Другая рука свободна для клавиатуры и меню."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Stick that steers"
msgstr "Стик для руля"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Which stick steers the truck (left / right). Its up / down stay free for other buttons."
msgstr "Какой стик рулит грузовиком (влево / вправо). Его вверх / вниз свободны для других кнопок."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steering dead zone"
msgstr "Мёртвая зона руля"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"How far you must push the stick before the wheel turns. More = a calm middle, less = it reacts "
"sooner."
msgstr ""
"Насколько отклонить стик, прежде чем руль повернёт. Больше = спокойная середина, меньше = "
"реагирует раньше."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Small turns (most of the stick)"
msgstr "Малые повороты (большая часть стика)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "even (off)"
msgstr "ровно (выкл)"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "up to %d %%"
msgstr "до %d %%"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid ""
"Most of the stick (the first %d %% of a push) makes small, careful turns, up to this much of the "
"wheel. Only the last bit, at the edge, turns hard."
msgstr ""
"Большая часть стика (первые %d %% хода) даёт малые, аккуратные повороты, до этой доли руля. "
"Только край, в конце, крутит резко."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Full stick turns the wheel"
msgstr "Полный стик крутит руль"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the wheel turns with the stick pushed all the way. 100 % = full lock."
msgstr "Насколько поворачивается руль при полностью отклонённом стике. 100 % = до упора."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel follows the stick"
msgstr "Руль следует за стиком"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "at once"
msgstr "сразу"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.3g s"
msgstr "%.3g с"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Smoothing while you hold the stick: how quickly the wheel goes where the stick points. More = "
"smoother, calmer."
msgstr ""
"Сглаживание, пока держишь стик: как быстро руль идёт туда, куда указывает стик. Больше = плавнее, "
"спокойнее."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Let go: back to the middle"
msgstr "Отпустил — к центру"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Let go of the stick: how the wheel comes back to straight. At once = at the wheel speed below. "
"More = a slow glide."
msgstr ""
"Отпустил стик: как руль возвращается к прямой. Сразу = на скорости руля ниже. Больше = плавное "
"скольжение."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel speed at most"
msgstr "Макс. скорость руля"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "no limit"
msgstr "без лимита"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2g s to full"
msgstr "%.2g с до упора"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The fastest the wheel turns (full push; a small push turns it slower): seconds from straight to "
"full lock."
msgstr "Самый быстрый поворот руля (полный ход; малый ход — медленнее): секунды от прямой до упора."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "At 90 km/h: steering"
msgstr "При 90 km/h: руль"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "On"
msgstr "Вкл"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(off)"
msgstr "(выкл)"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "On: at speed the wheel turns less, for calm highway driving. The % = how much at 90 km/h."
msgstr "Вкл: на скорости руль поворачивает меньше, для спокойной трассы. % = сколько при 90 km/h."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Driving off: no steering, gas or brake."
msgstr "Вождение выкл: без руля, газа и тормоза."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel: hold the grip(s) and turn your hands. Let go = straight."
msgstr "Руль: держи грип(ы) и крути руками. Отпустил = прямо."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Point: point left / right. On a panel the wheel holds."
msgstr "Наведение: наводи влево / вправо. На панели руля."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Most of the stick = small turns. All the way = hard turns."
msgstr "Большая часть стика = малые повороты. До края = резкие."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Sure? Reset"
msgstr "Точно? Сброс"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Reset tab"
msgstr "Сброс"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Puts this tab back to the default settings. Press twice to be sure."
msgstr "Возвращает эту вкладку к стандартным настройкам. Нажми дважды для подтверждения."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s + %s = %s"
msgstr "Задано: %s + %s = %s"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s = %s"
msgstr "Задано: %s = %s"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Press again: this tab goes back to the defaults."
msgstr "Нажми ещё раз: эта вкладка вернётся к стандартным."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Back to the defaults. Saved."
msgstr "Возвращено к стандартным. Сохранено."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Saved."
msgstr "Сохранено."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Choose that modifier button first (the buttons above)."
msgstr "Сначала выбери эту кнопку-модификатор (кнопки выше)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Steering with the wheel: those grips hold it (Driving tab)."
msgstr "Руль: эти грипы его держат (вкладка «Вождение»)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s holds the wheel (Driving tab)."
msgstr "%s держит руль (вкладка «Вождение»)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 1."
msgstr "%s — модификатор 1."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 2."
msgstr "%s — модификатор 2."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is the air mouse button (Mouse tab)."
msgstr "%s — кнопка воздушной мыши (вкладка «Мышь»)."

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "With these modifiers, %s opens the menu."
msgstr "С этими модификаторами %s открывает меню."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick moves the mouse (Mouse tab)."
msgstr "Этот стик двигает мышь (вкладка «Мышь»)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick steers (Driving tab)."
msgstr "Этот стик рулит (вкладка «Вождение»)."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Could not save config.ini (the change works until the game ends)."
msgstr "Не удалось сохранить config.ini (изменение действует до конца игры)."

