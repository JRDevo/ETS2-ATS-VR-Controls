msgstr "რამდენად უნდა მიწვეთ სტიკი, სანამ კურსორი დაიძვრება. მეტი = კურსორი არ მიცოცავს."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Air mouse button"
msgstr "საჰაერო მაუსის ღილაკი"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Hold this button and turn the controller: the pointer follows, like a laser pointer. Off = no air "
"mouse."
msgstr ""
"გეჭიროთ ეს ღილაკი და მოაბრუნეთ კონტროლერი: კურსორი მიჰყვება, ლაზერული მაჩვენებელივით. გამორთ. = "
"საჰაერო მაუსი არ არის."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Air mouse works while"
msgstr "საჰაერო მაუსი მუშაობს, როცა"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Button held"
msgstr "ღილაკი გეჭიროთ"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Toggled on"
msgstr "გადართვით"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Button held: only while you hold the button. Toggled on: one press switches it on, the next press "
"off."
msgstr "ღილაკი გეჭიროთ: მხოლოდ სანამ ღილაკი გეჭიროთ. გადართვით: ერთი დაჭერა რთავს, შემდეგი თიშავს."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Air mouse speed"
msgstr "საჰაერო მაუსის სიჩქარე"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.0f px/deg"
msgstr "%.0f px/გრად"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the pointer moves when you turn the controller, in pixels per degree."
msgstr "რამდენად მოძრაობს კურსორი კონტროლერის მობრუნებისას, პიქსელი გრადუსზე."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Changes work at once and are saved."
msgstr "ცვლილებები მაშინვე მოქმედებს და ინახება."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu size"
msgstr "მენიუს ზომა"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2f m wide"
msgstr "%.2f მ სიგანე"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How big this menu is (its width in metres)."
msgstr "რამდენად დიდია ეს მენიუ (სიგანე მეტრებში)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu distance"
msgstr "მენიუს მანძილი"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2f m"
msgstr "%.2f მ"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Closer"
msgstr "ახლოს"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Farther"
msgstr "შორს"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far this menu is from your head."
msgstr "რამდენად შორსაა ეს მენიუ თქვენი თავიდან."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard size"
msgstr "კლავიატურის ზომა"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How big the VR keyboard is (its width in metres)."
msgstr "რამდენად დიდია VR კლავიატურა (სიგანე მეტრებში)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard distance"
msgstr "კლავიატურის მანძილი"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(hidden)"
msgstr "(დამალული)"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the VR keyboard is from your head."
msgstr "რამდენად შორსაა VR კლავიატურა თქვენი თავიდან."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Show"
msgstr "ჩვენება"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Hide"
msgstr "დამალვა"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Full"
msgstr "სრული"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Compact"
msgstr "კომპაქტ."

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Show / hide the VR keyboard. Full = every key; Compact = only the main keys (narrower)."
msgstr ""
"VR კლავიატურის ჩვენება/დამალვა. სრული = ყველა ღილაკი; კომპაქტური = მხოლოდ მთავარი ღილაკები "
"(ვიწრო)."

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Bring the menu and the keyboard in front of me"
msgstr "მენიუსა და კლავიატურის ჩემ წინ მოტანა"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Moves the menu and the keyboard to where you look now."
msgstr "გადააქვს მენიუ და კლავიატურა იქ, სადაც ახლა იყურებით."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Menu open / close: hold %s for %.1f s"
msgstr "მენიუს გახსნა/დახურვა: გეჭიროთ %s %.1f წმ"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Move: point at a panel, hold the grip, move. Its stick: farther / closer."
msgstr "გადატანა: მიუთითეთ პანელზე, გეჭიროთ გრიპი, გადაიტანეთ. მისი სტიკი: შორს/ახლოს."

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "The keyboard stays when the menu closes (its x hides it)."
msgstr "კლავიატურა რჩება მენიუს დახურვისას (მისი x მალავს მას)."

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
