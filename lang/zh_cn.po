#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Menu open / close: hold %s for %.1f s"
msgstr "打开/关闭菜单：长按 %s %.1f 秒"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Move: point at a panel, hold the grip, move. Its stick: farther / closer."
msgstr "移动：指向面板，按住握把并移动。其摇杆=更远/更近。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "The keyboard stays when the menu closes (its x hides it)."
msgstr "菜单关闭后键盘仍保留（用×隐藏）。"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Dark"
msgstr "深色"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Blue"
msgstr "蓝色"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Grey"
msgstr "灰色"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Light"
msgstr "浅色"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Black"
msgstr "黑色"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Green"
msgstr "绿色"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Colours"
msgstr "颜色"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The colours of the menu and the keyboard."
msgstr "菜单和键盘的颜色。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Menu see-through"
msgstr "菜单透明度"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%d %% solid"
msgstr "%d%% 不透明"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid this menu is. - = more see-through, + = more solid."
msgstr "此菜单的不透明度。-=更透明，+=更不透明。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard see-through"
msgstr "键盘透明度"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How solid the VR keyboard is. - = more see-through, + = more solid."
msgstr "VR键盘的不透明度。-=更透明，+=更不透明。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Pointer smoothing"
msgstr "指针平滑"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Low"
msgstr "低"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Medium"
msgstr "中"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "High"
msgstr "高"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Calms a shaky hand: the menu pointer and the air mouse. Higher = steadier, but it follows a bit "
"later."
msgstr "减轻手抖：菜单指针和空中鼠标。越高越稳，但跟随会稍慢。"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s (no font)"
msgstr "%s（无字体）"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Language"
msgstr "语言"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Auto: %s"
msgstr "自动：%s"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The menu's language. Auto = the language the game is set to."
msgstr "菜单语言。自动=游戏所设语言。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Keyboard letters"
msgstr "键盘字母"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The letters on the VR keyboard, as printed in that country. Auto = as the menu. A key always "
"presses the same key in the game."
msgstr "VR键盘上的字母（按该国布局）。自动=同菜单。任何键在游戏中始终按下相同的键。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "- = more see-through, + = more solid."
msgstr "-=更透明，+=更不透明。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steer with"
msgstr "转向方式"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick"
msgstr "摇杆"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Wheel"
msgstr "方向盘"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Point"
msgstr "指向"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick: the stick steers. Wheel: hold the grip(s) and turn your hands like a steering wheel. "
"Point: point a controller left / right (on a panel the wheel holds). Off: no driving."
msgstr "摇杆：用摇杆转向。方向盘：握住握把，双手像方向盘一样转动。指向：手柄向左/右指（在方向盘所持面板上）。关：不驾驶。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hands turn for full lock"
msgstr "打满所需双手转角"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Point for full lock"
msgstr "打满所需指向幅度"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.0f deg"
msgstr "%.0f 度"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you turn your hands (like a wheel) for full lock. Less = quicker, more = calmer."
msgstr "打满时双手转动的角度（像方向盘）。越小越快，越大越平稳。"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far you point left / right for full lock. Less = quicker, more = calmer."
msgstr "打满时左右指向的角度。越小越快，越大越平稳。"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick on"
msgstr "摇杆开"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Stick off"
msgstr "摇杆关"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Stick on: the stick steers too (it wins while you push it). Stick off: only your hands steer, and "
"the stick's left / right are normal buttons again."
msgstr "摇杆开：摇杆也可转向（推动时优先）。摇杆关：仅用双手转向，摇杆左/右恢复为普通按键。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hold the wheel with"
msgstr "握方向盘的手"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "Either"
msgstr "任一"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Both: both grips together (one grip alone keeps its own job). Left / Right / Either: one grip is "
"enough -- that grip is then only the wheel (no modifier, no air mouse, no key on it)."
msgstr "两者：两握把同时（单独一个保持本职）。左/右/任一：一个握把即可——该握把仅作方向盘（无修饰、无空中鼠标、无按键）。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Hand that points"
msgstr "指向的手"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "The controller you point with. The other hand stays free for the keyboard and the menu."
msgstr "用于指向的手柄。另一只手留给键盘和菜单。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Stick that steers"
msgstr "转向的摇杆"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Which stick steers the truck (left / right). Its up / down stay free for other buttons."
msgstr "用哪个摇杆为卡车转向（左/右）。其上/下留给其他按键。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Steering dead zone"
msgstr "转向死区"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"How far you must push the stick before the wheel turns. More = a calm middle, less = it reacts "
"sooner."
msgstr "方向盘开始转动前需推动摇杆的幅度。越大中间越平稳，越小反应越快。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Small turns (most of the stick)"
msgstr "小幅转向（摇杆大部分）"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "even (off)"
msgstr "均匀（关）"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "up to %d %%"
msgstr "最多 %d%%"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid ""
"Most of the stick (the first %d %% of a push) makes small, careful turns, up to this much of the "
"wheel. Only the last bit, at the edge, turns hard."
msgstr "摇杆大部分（推动的前 %d%%）做小而精细的转向，最多到方向盘的此比例。只有边缘最后一段才大幅转。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Full stick turns the wheel"
msgstr "满杆时方向盘转角"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "How far the wheel turns with the stick pushed all the way. 100 % = full lock."
msgstr "摇杆推到底时方向盘转动的幅度。100%=打满。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel follows the stick"
msgstr "方向盘跟随摇杆"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "at once"
msgstr "立即"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.3g s"
msgstr "%.3g 秒"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Smoothing while you hold the stick: how quickly the wheel goes where the stick points. More = "
"smoother, calmer."
msgstr "推住摇杆时的平滑：方向盘转到摇杆所指方向的快慢。越大越平滑、越平稳。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Let go: back to the middle"
msgstr "松开：回正中"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"Let go of the stick: how the wheel comes back to straight. At once = at the wheel speed below. "
"More = a slow glide."
msgstr "松开摇杆时方向盘回正的方式。立即=按下方方向盘速度。越大回得越慢。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel speed at most"
msgstr "方向盘最高速度"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "no limit"
msgstr "无限制"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%.2g s to full"
msgstr "%.2g 秒打满"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid ""
"The fastest the wheel turns (full push; a small push turns it slower): seconds from straight to "
"full lock."
msgstr "方向盘转动的最高速度（满推时；轻推更慢）：从回正到打满的秒数。"

#. Name of a setting row (about 30 Latin characters)
#: src/vr_menu.cpp
msgid "At 90 km/h: steering"
msgstr "90 km/h 时转向"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "On"
msgstr "开"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
msgid "(off)"
msgstr "（关）"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "On: at speed the wheel turns less, for calm highway driving. The % = how much at 90 km/h."
msgstr "开：车速越高方向盘转得越少，高速更平稳。%=在90 km/h时的比例。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Driving off: no steering, gas or brake."
msgstr "驾驶关：无转向、油门或刹车。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Wheel: hold the grip(s) and turn your hands. Let go = straight."
msgstr "方向盘：握住握把并转动双手。松开=回正。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Point: point left / right. On a panel the wheel holds."
msgstr "指向：向左/右指。在方向盘所持的面板上。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Most of the stick = small turns. All the way = hard turns."
msgstr "摇杆大部分=小幅转向。推到底=大幅转向。"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Sure? Reset"
msgstr "确定？重置"

#. Button (short: about 10 Latin characters; the font shrinks a little when needed)
#: src/vr_menu.cpp
msgid "Reset tab"
msgstr "重置本页"

#. Help shown at the bottom while the pointer is on something (up to 2 lines, about 110 Latin characters)
#: src/vr_menu.cpp
msgid "Puts this tab back to the default settings. Press twice to be sure."
msgstr "将此页恢复为默认设置。按两次以确认。"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s + %s = %s"
msgstr "设置：%s + %s = %s"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "Set: %s = %s"
msgstr "设置：%s = %s"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Press again: this tab goes back to the defaults."
msgstr "再按一次：此页恢复为默认。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Back to the defaults. Saved."
msgstr "已恢复默认。已保存。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Saved."
msgstr "已保存。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Choose that modifier button first (the buttons above)."
msgstr "请先选择该修饰按键（上方按键）。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Steering with the wheel: those grips hold it (Driving tab)."
msgstr "正用方向盘转向：那些握把握住它（驾驶页）。"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s holds the wheel (Driving tab)."
msgstr "%s 握住方向盘（驾驶页）。"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 1."
msgstr "%s 是修饰键1。"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is modifier 2."
msgstr "%s 是修饰键2。"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "%s is the air mouse button (Mouse tab)."
msgstr "%s 是空中鼠标按键（鼠标页）。"

#. Value or choice (about 18 Latin characters)
#: src/vr_menu.cpp
#, c-format
msgid "With these modifiers, %s opens the menu."
msgstr "在这些修饰键下，%s 打开菜单。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick moves the mouse (Mouse tab)."
msgstr "该摇杆移动鼠标（鼠标页）。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "That stick steers (Driving tab)."
msgstr "该摇杆转向（驾驶页）。"

#. Status / hint line at the bottom (one line, about 55 Latin characters)
#: src/vr_menu.cpp
msgid "Could not save config.ini (the change works until the game ends)."
msgstr "无法保存 config.ini（更改在游戏结束前有效）。"

